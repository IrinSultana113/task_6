<% content_for :title, "Enter" %>
<% content_for :body_class, "min-h-screen bg-ink-950 text-ink-50 antialiased overflow-hidden" %>

<div class="relative min-h-screen flex flex-col">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-32 -left-24 h-[28rem] w-[28rem] rounded-full bg-teal-500/20 blur-[100px] animate-drift"></div>
    <div class="absolute top-1/3 -right-20 h-[24rem] w-[24rem] rounded-full bg-amber-400/15 blur-[110px] animate-drift-slow"></div>
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, #94a3b8 1px, transparent 0); background-size: 28px 28px;"></div>
  </div>

  <header class="relative z-10 flex items-center justify-between px-6 py-5 sm:px-10">
    <div class="flex items-center gap-3">
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-teal-400 to-cyan-600 shadow-lg shadow-teal-500/30">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/></svg>
      </span>
      <span class="font-display text-xl tracking-tight text-white">Inkroom</span>
    </div>
    <p class="hidden sm:block text-sm text-ink-400">Collaborative boards · no account needed</p>
  </header>

  <main class="relative z-10 flex flex-1 flex-col items-center justify-center px-6 pb-16">
    <div class="w-full max-w-md animate-rise">
      <p class="mb-3 font-display text-sm font-medium tracking-wide text-teal-300/90">Start drawing together</p>
      <h1 class="font-serif text-4xl sm:text-5xl leading-[1.1] text-white mb-4">
        Your ideas,<br>shared in ink.
      </h1>
      <p class="text-ink-300 text-base leading-relaxed mb-8 max-w-sm">
        Open a board, invite anyone with the link, and sketch in real time. Pick a nickname — that’s all it takes.
      </p>

      <% if flash[:alert] %>
        <div class="mb-4 rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with url: session_path, method: :post, class: "space-y-4", data: { turbo: false } do |f| %>
        <label class="block">
          <span class="mb-2 block text-xs font-medium uppercase tracking-[0.14em] text-ink-400">Nickname</span>
          <input
            type="text"
            name="nickname"
            maxlength="40"
            required
            autofocus
            autocomplete="nickname"
            placeholder="e.g. Mira, SketchFox…"
            class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3.5 text-base text-white placeholder:text-ink-500 outline-none transition focus:border-teal-400/60 focus:bg-white/8 focus:ring-4 focus:ring-teal-400/15"
          >
        </label>
        <button type="submit" class="group relative w-full overflow-hidden rounded-2xl bg-teal-400 px-4 py-3.5 text-base font-semibold text-ink-950 transition hover:bg-teal-300 focus:outline-none focus:ring-4 focus:ring-teal-400/30">
          <span class="relative z-10 flex items-center justify-center gap-2">
            Enter the lobby
            <svg class="h-4 w-4 transition group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </button>
      <% end %>
    </div>
  </main>

  <footer class="relative z-10 px-6 pb-6 text-center text-xs text-ink-500 sm:px-10">
    Draw forever · Sync instantly · No sign-up
  </footer>
</div>
